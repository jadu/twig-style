{
    "name": "jadu/twig-style",
    "description": "Jadu Twig coding style configuration for Twig-CS-Fixer",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "vincentlanglet/twig-cs-fixer": "^4.0.0",
        "webmozart/assert": "^1.10.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.14.0",
        "jadu/php-style": "^2.0.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Jadu\\Style\\Twig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jadu\\Style\\Twig\\Tests\\": "tests/"
        }
    },
    "config": {
        "audit": {
            "block-insecure": false
        },
        "sort-packages": true
    },
    "conflict": {
        "twig/twig": ">=3.21.0"
    }
}
